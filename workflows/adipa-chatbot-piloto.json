          "string": [
            {
              "value1": "={{$json.textoNormalizado}}",
              "operation": "regex",
              "value2": "resbal|lesion|accident|golpe|cai\\b"
            }
          ]
        }
      },
      "id": "15443824-5b7b-4886-acab-0e9eac29fbe6",
      "name": "IF accidente",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
