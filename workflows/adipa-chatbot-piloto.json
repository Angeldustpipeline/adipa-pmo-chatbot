{
  "name": "ADIPA - Chatbot de consultas - Piloto documentado",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "adipa-chatbot",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "5543c93f-d714-40f6-bcef-ba7c63e5c41c",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        16,
        480
      ]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst body = item.body || {};\nconst query = item.query || {};\nconst mensajeOriginal = body.mensaje || body.text || query.mensaje || '';\n\nfunction normalizar(t) {\n  return t\n    .toLowerCase()\n    .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '');\n}\n\nreturn [{\n  json: {\n    mensajeOriginal,\n    textoNormalizado: normalizar(mensajeOriginal),\n    colaborador: body.colaborador || 'desconocido',\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "111cfbaf-1836-4097-82e2-392831d43776",
      "name": "Normaliza texto",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        480
      ]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.textoNormalizado}}",
              "operation": "regex",
              "value2": "vacacion|anticipacion"
            }
          ]
        }
      },
      "id": "e9bbbb35-54de-4969-9720-d63faa10fadd",
      "name": "IF vacaciones",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
